{
  "name": "@zccz14/ux",
  "version": "0.6.1",
  "description": "Unified app shell and Markdown renderer for the NTNL app family: one animated icon sidebar, a fixed-size logo that doubles as the page favicon, the Linkit-integrated AppHeader, and the single Markdown surface every app renders through.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zccz14/ux.git"
  },
  "homepage": "https://github.com/zccz14/ux#readme",
  "bugs": {
    "url": "https://github.com/zccz14/ux/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "test": "vitest run && node scripts/check-styles.mjs && node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.6.0",
    "linkit-react-components": "^0.6.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "mermaid": "^11.17.2",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math-extended": "^6.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "auth-mini-react-components": "^0.6.10",
    "jsdom": "^26.1.0",
    "linkit-react-components": "^0.6.0",
    "lucide-react": "^1.31.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
